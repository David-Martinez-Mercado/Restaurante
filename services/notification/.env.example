NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=notification_service
# Debe ser el MISMO secreto de acceso que usa el User Service (solo verifica tokens).
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
AUDIT_SERVICE_URL=http://localhost:3004
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

CUSTOMER_SERVICE_URL=http://localhost:3008
RESERVATION_SERVICE_URL=http://localhost:3007

# --- Telegram ---
# 1) En Telegram abre @BotFather, manda /newbot y copia el token que te da.
# 2) Pégalo aquí y escribe el nombre de usuario del bot (sin @).
# Sin token el canal funciona en modo SIMULADO: los avisos se registran pero no salen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Zona horaria de los mensajes. Vacío = la del servidor (recomendado: coincide con las reglas de horario).
TIMEZONE=
