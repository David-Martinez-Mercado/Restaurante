NODE_ENV=development
PORT=3006
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=payment_service
# Debe ser el MISMO secreto de acceso que usa el User Service (solo verifica tokens).
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
AUDIT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

ORDER_SERVICE_URL=http://localhost:3003

# --- Pasarela de pago (la construye otro equipo; ver docs/CONTRATO-PASARELA-DE-PAGO.md) ---
# Vacío = pasarela NO conectada: el cobro se crea y la API devuelve el cuerpo que se
# le enviaría (campo gatewayRequest), pero no se contacta a nadie.
PAYMENT_GATEWAY_URL=
# Si la pasarela pide autenticación, se envía como "Authorization: Bearer <llave>".
PAYMENT_GATEWAY_API_KEY=
# Secreto compartido con la pasarela para firmar el webhook (HMAC-SHA256 del cuerpo).
PAYMENT_WEBHOOK_SECRET=cambia-este-secreto-del-webhook-min-16
# URL pública de la API (gateway) a la que la pasarela enviará el webhook.
PUBLIC_API_URL=http://localhost:3000
# URL del front a la que se regresa al cliente después de pagar.
WEB_URL=http://localhost:5173
