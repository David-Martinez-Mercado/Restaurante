NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=reservation_service
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
MENU_SERVICE_URL=http://localhost:3002
CUSTOMER_SERVICE_URL=http://localhost:3008
AUDIT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

# --- Reglas de reservación (hora local del servidor) ---
# Hora de llegada más temprana y más tarde que se puede reservar (HH:MM).
RESERVATION_OPEN=13:00
RESERVATION_LAST_ARRIVAL=22:00
# Las llegadas se reservan cada N minutos.
RESERVATION_SLOT_MINUTES=30
# Cuánto tiempo ocupa una reservación (para calcular el aforo).
RESERVATION_STAY_MINUTES=120
# Comensales máximos al mismo tiempo.
RESERVATION_CAPACITY=40
# Minutos antes de la llegada en que se avisa "ya casi es la hora".
RESERVATION_REMINDER_MINUTES=30
