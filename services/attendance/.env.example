NODE_ENV=development
PORT=3009
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=attendance_service
# Debe ser el MISMO secreto de acceso que usa el User Service (solo verifica tokens).
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
AUDIT_SERVICE_URL=http://localhost:3004
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

# --- Reglas del checador ---
# Días laborables: 0=domingo, 1=lunes ... 6=sábado. Un día laborable sin ningún registro cuenta como falta.
ATTENDANCE_WORKDAYS=1,2,3,4,5,6
# Horas por jornada: lo que pase de esto en un mismo día son horas extra.
ATTENDANCE_DAILY_HOURS=8
# Una entrada abierta por más de estas horas se considera "olvidó checar salida" y debe corregirla el gerente.
ATTENDANCE_STALE_HOURS=16
# Evita el doble clic: no se puede checar salida dentro de este tiempo después de la entrada.
ATTENDANCE_MIN_SHIFT_MINUTES=1
