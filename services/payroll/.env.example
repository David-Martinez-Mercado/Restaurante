NODE_ENV=development
PORT=3010
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=payroll_service
# Debe ser el MISMO secreto de acceso que usa el User Service (solo verifica tokens).
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
AUDIT_SERVICE_URL=http://localhost:3004
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

ATTENDANCE_SERVICE_URL=http://localhost:3009

# --- Motor de nómina EXTERNO: repo SistemaNomina (otro autor), sin modificar ---
# Lo levanta integraciones/nomina-externo.cjs en estos puertos (el original usa 3001-3006 y chocaría con nosotros).
NOMINA_EMPLOYEES_URL=http://127.0.0.1:3102
NOMINA_PAYROLL_URL=http://127.0.0.1:3103
NOMINA_INCIDENTS_URL=http://127.0.0.1:3104

# --- Reglas de cálculo propias (horas extra y faltas) ---
# Las horas extra se pagan a este múltiplo de la hora normal (Ley Federal del Trabajo: doble, hasta 9 h por semana).
PAYROLL_OVERTIME_MULTIPLIER=2
# Horas de una jornada normal (el valor de la hora = sueldo mensual / 30 / esto).
PAYROLL_DAILY_HOURS=8
