NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=billing_service
# Debe ser el MISMO secreto de acceso que usa el User Service (solo verifica tokens).
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-en-produccion-min-16
CORS_ORIGINS=http://localhost:5173
AUDIT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Llave para las rutas internas entre servicios. Igual en todos los servicios.
INTERNAL_API_KEY=cambia-esta-llave-interna-min-16

ORDER_SERVICE_URL=http://localhost:3003
CUSTOMER_SERVICE_URL=http://localhost:3008

# --- PAC: Profact (TimbraCFDI API v2) ---
# Documentación: https://developers.timbracfdi33.mx
# PRUEBAS (por defecto): no requiere cuenta ni cobra; el token de abajo es el de pruebas que Profact publica en su documentación.
# PRODUCCIÓN: pide tu alta de integrador a soporte@profact.com.mx, y cambia la URL por
#   https://timbracfdi33.mx:1444/api/v2 y el token por el que te entreguen.
PROFACT_URL=https://pruebas.timbracfdi33.mx:1444/api/v2
PROFACT_TOKEN=mvpNUXmQfK8=

# --- Emisor: el restaurante (quien factura) ---
# Por defecto, el RFC de PRUEBAS estándar del SAT (ya registrado en el ambiente de pruebas de Profact).
# Para facturar de verdad: pon tu RFC/nombre/régimen/CP tal como están en tu Constancia de Situación Fiscal
# y registra tu CSD una vez con:  npm run profact:registra-emisor
BILLING_EMISOR_RFC=EKU9003173C9
BILLING_EMISOR_NAME=ESCUELA KEMPER URGATE
# Régimen fiscal del emisor (601 = General de Ley Personas Morales, 612 = Personas Físicas con Actividad Empresarial...).
BILLING_EMISOR_REGIME=601
# Código postal del lugar de expedición.
BILLING_EMISOR_POSTAL_CODE=42501

BILLING_SERIE=A
# Zona horaria del lugar de expedición: el SAT rechaza CFDI con fecha "del futuro".
BILLING_TIMEZONE=America/Mexico_City
